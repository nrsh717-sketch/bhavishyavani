

<!DOCTYPE html>
<html lang="en">
<head>
<meta charset="UTF-8">
<meta name="viewport" content="width=device-width, initial-scale=1.0">
<title>BHAVISHYAVANI - Your Future, Your Stars</title>
<style>
*{box-sizing:border-box;margin:0;padding:0}
body{font-family:Arial,sans-serif;background:#fffaf0;color:#29213b;line-height:1.6}
header{background:linear-gradient(135deg,#241044,#6d2695);color:white;text-align:center;padding:35px 15px}
header h1{font-size:34px;letter-spacing:3px}
header p{color:#f6d98a}
nav{background:#351653;padding:13px;text-align:center}
nav a{color:white;text-decoration:none;margin:0 12px;font-size:14px}
.hero{text-align:center;padding:45px 15px;background:linear-gradient(120deg,#fff0cb,#f5e5ff)}
.hero h2{font-size:27px;color:#51216f}
.hero p{margin:12px auto;max-width:600px}
.btn{display:inline-block;background:#e4a92e;color:#27113c;padding:12px 23px;border:0;border-radius:25px;font-weight:bold;text-decoration:none;cursor:pointer;margin:8px}
section{padding:35px 15px;text-align:center}
h2{color:#572477;margin-bottom:18px}
.cards{display:grid;grid-template-columns:repeat(auto-fit,minmax(140px,1fr));gap:13px;max-width:950px;margin:auto}
.card{background:white;padding:20px 10px;border-radius:14px;box-shadow:0 3px 12px #0001;border:1px solid #f0dfc5}
.symbol{font-size:32px}
.card h3{color:#592477;margin:7px}
form{max-width:520px;margin:auto;background:white;padding:22px;border-radius:15px;box-shadow:0 3px 15px #0001;text-align:left}
input,select{width:100%;padding:12px;margin:8px 0 15px;border:1px solid #d8c8e2;border-radius:8px;font-size:16px}
label{font-weight:bold}
#result{display:none;max-width:600px;margin:20px auto;padding:20px;background:#fff0cb;border-radius:12px}
footer{background:#241044;color:white;text-align:center;padding:25px}
</style>
</head>
<body>

<header>
<h1>✦ BHAVISHYAVANI ✦</h1>
<p>Your Future, Your Stars</p>
</header>

<nav>
<a href="#home">Home</a>
<a href="#kundli">Free Kundli</a>
<a href="#rashis">12 Rashis</a>
<a href="#daily">Daily Horoscope</a>
</nav>

<div class="hero" id="home">
<h2>Discover Your Destiny</h2>
<p>Explore astrology, zodiac signs and your spiritual journey with BHAVISHYAVANI.</p>
<a href="#kundli" class="btn">Create Your Kundli</a>
</div>

<section id="kundli">
<h2>Free Kundli Registration</h2>
<p>Enter your birth details to get started.</p>
<form id="kundliForm">
<label>Your Name</label>
<input id="name" type="text" placeholder="Enter your name" required>

<label>Date of Birth</label>
<input id="dob" type="date" required>

<label>Time of Birth</label>
<input id="tob" type="time" required>

<label>Place of Birth</label>
<input id="place" type="text" placeholder="City / Town" required>

<label>Language</label>
<select id="language">
<option>English</option>
<option>తెలుగు</option>
<option>Hindi</option>
</select>

<button class="btn" type="submit">Submit Birth Details</button>
</form>
<div id="result"></div>
</section>

<section id="rashis">
<h2>12 Zodiac Signs</h2>
<div class="cards">
<div class="card"><div class="symbol">♈</div><h3>Aries</h3><p>Mesha</p></div>
<div class="card"><div class="symbol">♉</div><h3>Taurus</h3><p>Vrishabha</p></div>
<div class="card"><div class="symbol">♊</div><h3>Gemini</h3><p>Mithuna</p></div>
<div class="card"><div class="symbol">♋</div><h3>Cancer</h3><p>Karka</p></div>
<div class="card"><div class="symbol">♌</div><h3>Leo</h3><p>Simha</p></div>
<div class="card"><div class="symbol">♍</div><h3>Virgo</h3><p>Kanya</p></div>
<div class="card"><div class="symbol">♎</div><h3>Libra</h3><p>Tula</p></div>
<div class="card"><div class="symbol">♏</div><h3>Scorpio</h3><p>Vrischika</p></div>
<div class="card"><div class="symbol">♐</div><h3>Sagittarius</h3><p>Dhanus</p></div>
<div class="card"><div class="symbol">♑</div><h3>Capricorn</h3><p>Makara</p></div>
<div class="card"><div class="symbol">♒</div><h3>Aquarius</h3><p>Kumbha</p></div>
<div class="card"><div class="symbol">♓</div><h3>Pisces</h3><p>Meena</p></div>
</div>
</section>

<section id="daily">
<h2>Daily Horoscope</h2>
<p>Choose your zodiac sign and read a general daily message.</p>
<select id="sign">
<option value="">Select your Rashi</option>
<option>Aries</option><option>Taurus</option><option>Gemini</option>
<option>Cancer</option><option>Leo</option><option>Virgo</option>
<option>Libra</option><option>Scorpio</option><option>Sagittarius</option>
<option>Capricorn</option><option>Aquarius</option><option>Pisces</option>
</select>
<button class="btn" onclick="horoscope()">See Horoscope</button>
<div id="dailyResult"></div>
</section>

<footer>
<h3>BHAVISHYAVANI</h3>
<p>Your Future, Your Stars</p>
<p>For spiritual guidance and astrology information.</p>
<p>© 2026 BHAVISHYAVANI</p>
</footer>

<script>
document.getElementById("kundliForm").addEventListener("submit",function(e){
e.preventDefault();
let n=document.getElementById("name").value;
let d=document.getElementById("dob").value;
let t=document.getElementById("tob").value;
let p=document.getElementById("place").value;
let l=document.getElementById("language").value;
let r=document.getElementById("result");
r.style.display="block";
r.innerHTML="<h3>Thank you, "+n+"!</h3><p>Your birth details have been entered.</p><p>Date: "+d+"</p><p>Time: "+t+"</p><p>Place: "+p+"</p><p>Language: "+l+"</p><p><b>Note:</b> This demo does not calculate an actual Vedic Kundli.</p>";
});

function horoscope(){
let s=document.getElementById("sign").value;
let r=document.getElementById("dailyResult");
if(!s){r.innerHTML="Please select your Rashi.";return;}
r.style.display="block";
r.innerHTML="<div class='card'><h3>"+s+" Horoscope</h3><p>Stay positive, think carefully before making decisions, and give time to your family and well-being. This is a general inspirational message, not a calculated astrological prediction.</p></div>";
}
</script>
</body>
</html>


